<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textShopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/dashboard_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_secondary_dark" />

        <include
            android:id="@+id/skeletonLoader"
            layout="@layout/layout_skeleton_dashboard"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/dashboardGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNewBill"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_700">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_sale" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/new_bill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomers"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_customers" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/customers" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardItems"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_500">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_items" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/items" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillsHistory"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_800">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_history" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/bills_history" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_900">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_settings" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
</ScrollView>
