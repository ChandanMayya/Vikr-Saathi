<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodToday"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodWeek"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodMonth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_month" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/textPeriodRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary_dark" />

            <include
                android:id="@+id/skeletonLoader"
                layout="@layout/layout_skeleton_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPeriodSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layoutTodaySales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/textSalesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_sales_title"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textTodaySalesAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/orange_700"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSalesComparison"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:id="@+id/textTodayBillCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textAverageBill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textCustomerDues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textVendorPayables"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrossProfit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_gross_profit"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/buttonProfitInfo"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/dashboard_profit_info"
                                android:src="@android:drawable/ic_dialog_info" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textGrossProfit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textProfitDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary_dark" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTopItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textTopItemsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_top_items"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/text_primary_dark"
                            android:textStyle="bold" />

                        <com.kex.vikrsaathi.ui.dashboard.TopItemsBarChartView
                            android:id="@+id/topItemsChart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textTopItemsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/dashboard_top_items_empty"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?android:attr/textColorSecondary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLowStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/low_stock_items"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/text_primary_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLowStockSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/text_secondary_dark" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerLowStock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textLowStockViewAll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:text="@string/low_stock_view_all"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/text_accent"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_expiry_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textExpirySummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/dashboard_quick_actions"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dashboardGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNewBill"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_700">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_sale" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/new_bill" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBillsHistory"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_history" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/bills_history" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <GridLayout
            android:id="@+id/rowMasters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardItems"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_500">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconItems"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_items" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:gravity="center"
                        android:text="@string/items" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomers"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_800">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconCustomers"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_customers" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:gravity="center"
                        android:text="@string/customers" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendors"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                android:visibility="gone"
                app:cardBackgroundColor="@color/orange_900">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconVendors"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_vendors" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:gravity="center"
                        android:text="@string/vendors" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <GridLayout
            android:id="@+id/rowTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStock"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_800">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconStock"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_stock" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/inventory" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnalysis"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_700">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconAnalysis"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_analysis" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/analysis" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOrders"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_columnWeight="1"
                android:visibility="gone"
                app:cardBackgroundColor="@color/orange_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconOrders"
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_orders" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:gravity="center"
                        android:text="@string/orders" />

                    <TextView
                        android:id="@+id/textOrdersAttention"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/orange_on_primary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                style="@style/VikrSaathiDashboardCard"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="@color/orange_900">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        style="@style/VikrSaathiDashboardCardIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard_settings" />

                    <TextView
                        style="@style/VikrSaathiDashboardCardLabel"
                        android:text="@string/settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
