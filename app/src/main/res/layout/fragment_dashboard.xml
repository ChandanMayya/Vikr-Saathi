<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="168dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodToday"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodWeek"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPeriodMonth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_period_month" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/textPeriodRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary_dark" />

            <include
                android:id="@+id/skeletonLoader"
                layout="@layout/layout_skeleton_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPeriodSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layoutTodaySales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/textSalesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_sales_title"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textTodaySalesAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/orange_700"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textSalesComparison"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:id="@+id/textTodayBillCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textAverageBill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary_dark" />

                    <TextView
                        android:id="@+id/textCustomerDues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textVendorPayables"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrossProfit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_gross_profit"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/buttonProfitInfo"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/dashboard_profit_info"
                                android:src="@android:drawable/ic_dialog_info" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textGrossProfit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textProfitDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary_dark" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTopItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textTopItemsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_top_items"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/text_primary_dark"
                            android:textStyle="bold" />

                        <com.kex.vikrsaathi.ui.dashboard.TopItemsBarChartView
                            android:id="@+id/topItemsChart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textTopItemsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/dashboard_top_items_empty"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?android:attr/textColorSecondary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLowStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/low_stock_items"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/text_primary_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLowStockSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/text_secondary_dark" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerLowStock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textLowStockViewAll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:text="@string/low_stock_view_all"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/text_accent"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_due_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textDueSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:contentPadding="12dp"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_expiry_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textExpirySummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/quickActionsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quick_actions_panel"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone"
        app:behavior_draggable="true"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="156dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/quickActionsHandle"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/dashboard_expand_quick_actions"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/quickActionsGrab"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_quick_actions_grab"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickActionsTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/dashboard_expand_quick_actions"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/quick_actions_content_inset"
            android:paddingEnd="@dimen/quick_actions_content_inset"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/textQuickActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_quick_actions"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/quickActionsChevron"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_up"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/quickActionsExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="true"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <androidx.constraintlayout.motion.widget.MotionLayout
                android:id="@+id/quickActionsMotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/quick_actions_content_inset"
                android:paddingEnd="@dimen/quick_actions_content_inset"
                android:paddingBottom="@dimen/quick_actions_content_inset"
                app:layoutDescription="@xml/scene_quick_actions">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNewBill"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    app:cardBackgroundColor="@color/surface_muted"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <View
                                android:id="@+id/backingNewBill"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_quick_action_icon" />

                            <ImageView
                                android:id="@+id/iconNewBill"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard_sale"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelNewBill"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/new_bill"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBillsHistory"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    app:cardBackgroundColor="@color/surface_muted"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <View
                                android:id="@+id/backingBillsHistory"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_quick_action_icon" />

                            <ImageView
                                android:id="@+id/iconBillsHistory"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard_history"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelBillsHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/bills_history"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardItems"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    app:cardBackgroundColor="@color/surface_muted"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <View
                                android:id="@+id/backingItems"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_quick_action_icon" />

                            <ImageView
                                android:id="@+id/iconItems"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard_items"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelItems"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/items"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCustomers"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    app:cardBackgroundColor="@color/surface_muted"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <View
                                android:id="@+id/backingCustomers"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_quick_action_icon" />

                            <ImageView
                                android:id="@+id/iconCustomers"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard_customers"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelCustomers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/customers"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendors"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    app:cardBackgroundColor="@color/orange_900"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/iconVendors"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dashboard_vendors"
                            app:tint="@color/orange_on_primary" />

                        <TextView
                            android:id="@+id/labelVendors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/vendors"
                            android:textColor="@color/orange_on_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStock"
                    style="@style/VikrSaathiDashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    app:cardBackgroundColor="@color/orange_800"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/iconStock"
