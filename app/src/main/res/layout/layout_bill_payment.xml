<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBillPayment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_section"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textPaymentSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/radioPaymentMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioPayCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_cash" />

        <RadioButton
            android:id="@+id/radioPayUpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_upi" />

        <RadioButton
            android:id="@+id/radioPayCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_credit" />

        <RadioButton
            android:id="@+id/radioPaySplit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_split" />

        <RadioButton
            android:id="@+id/radioPayLegacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_keep_legacy"
            android:visibility="gone" />
    </RadioGroup>

    <TextView
        android:id="@+id/textPaymentHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_split_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSplitCash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/payment_cash_amount"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSplitCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSplitUpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/payment_upi_amount"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSplitUpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSplitCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/payment_credit_amount"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSplitCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
