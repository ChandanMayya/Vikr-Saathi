<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textReturnWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textReturnSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/text_primary_dark" />

    <LinearLayout
        android:id="@+id/rowExchangeActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenExchange"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/return_open_exchange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrintExchange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/print" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonVoidReturn"
        style="@style/VikrSaathiOutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/return_void"
        android:visibility="gone" />
</LinearLayout>
