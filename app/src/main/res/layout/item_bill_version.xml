<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/viewVersionDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_version_dot" />

        <View
            android:id="@+id/viewVersionLine"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@color/stroke_default" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVersion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/ripple_subtle"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textVersionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/text_accent"
                    android:textStyle="bold"
                    tools:text="v3 · Current" />

                <TextView
                    android:id="@+id/textVersionTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"
                    tools:text="Total ₹1,240.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/textVersionActor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                tools:text="By This device" />

            <TextView
                android:id="@+id/textVersionWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                tools:text="11 Nov 2026, 10:42 AM" />

            <TextView
                android:id="@+id/textVersionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary_dark"
                tools:text="Quantity changed: Tea 2 → 3" />

            <LinearLayout
                android:id="@+id/rowReadOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/version_read_only"
                    android:textColor="@color/text_secondary_dark"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/edit_current_version"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_edit"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutVersionDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textVersionDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    tools:text="Version details · v3 (Current)" />

                <TextView
                    android:id="@+id/textSaleDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary_dark"
                    tools:text="Sale date 6 Nov 2026, 1:20 PM" />

                <TextView
                    android:id="@+id/textCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold"
                    tools:text="Walk-in customer" />

                <TextView
                    android:id="@+id/textCustomerMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary_dark"
                    android:visibility="gone"
                    tools:text="99999 · Market Road" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version_col_item"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_col_qty_price"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/version_col_amount"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textSubtotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:textColor="@color/text_primary_dark"
                    tools:text="Subtotal: ₹120.00" />

                <TextView
                    android:id="@+id/textDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text_secondary_dark"
                    android:visibility="gone"
                    tools:text="Discount: ₹12.00" />

                <TextView
                    android:id="@+id/textRoundOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text_secondary_dark"
                    android:visibility="gone"
                    tools:text="Bill Round Off: ₹0.00" />

                <TextView
                    android:id="@+id/textDetailTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_accent"
                    android:textStyle="bold"
                    tools:text="Grand Total: ₹1,240.00" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/payment_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary_dark"
                    tools:text="Cash ₹1,240.00" />

                <LinearLayout
                    android:id="@+id/rowVersionActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRestoreVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/restore"
                        app:icon="@drawable/ic_redo"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPrintVersion"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:minHeight="48dp"
                        android:text="@string/print"
                        android:textColor="@color/text_accent_soft"
                        app:icon="@drawable/ic_print"
                        app:iconTint="@color/text_accent_soft"
                        app:strokeColor="@color/stroke_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDuplicateVersion"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/duplicate"
                        android:textColor="@color/text_accent_soft"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="@color/text_accent_soft"
                        app:strokeColor="@color/stroke_button" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textRestoreHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Restoring creates v4 and keeps v1–v3 in history."
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
