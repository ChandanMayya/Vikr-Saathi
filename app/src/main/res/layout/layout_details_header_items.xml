<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDetailsHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="56dp"
        android:text="@string/col_name"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/text_secondary_dark"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/col_mrp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="end"
            android:text="@string/col_discount"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="end"
            android:text="@string/col_stock"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:gravity="end"
            android:text="@string/col_barcode"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
