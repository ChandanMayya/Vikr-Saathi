<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:elevation="8dp"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bills_history_options"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/filter_section"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSearchFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/filter_search_bill" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDateRangeFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_date_range" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCounterRangeFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/filter_counter_range" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sort_section"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSortByDateAsc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sort_by_date_asc" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSortByInvoiceNumberAsc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sort_by_invoice_number_asc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reports_section"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDownloadPdfReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/download_pdf_report"
            app:strokeColor="@color/stroke_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDownloadExcelReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_excel_report"
            app:strokeColor="@color/stroke_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUploadExcelBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/upload_excel_backup" />
    </LinearLayout>
</ScrollView>
