<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="1dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_branding_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/header_image"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <ImageView
                    android:id="@+id/imageHeaderPreview"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/dashboard_bg"
                    android:contentDescription="@string/header_image"
                    android:scaleType="fitCenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonChangeHeader"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/change_header_image" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/shop_logo_image"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <ImageView
                    android:id="@+id/imageLogoPreview"
                    android:layout_width="120dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/dashboard_bg"
                    android:contentDescription="@string/shop_logo_image"
                    android:scaleType="fitCenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonChangeLogo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/change_shop_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/signature_image"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <ImageView
                    android:id="@+id/imageSignaturePreview"
                    android:layout_width="160dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/dashboard_bg"
                    android:contentDescription="@string/signature_image"
                    android:scaleType="fitCenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonChangeSignature"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/change_signature_image" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
