<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textLineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/text_primary_dark"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textLineMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textLinePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonQtyMinus"
            style="@style/VikrSaathiStepperButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/return_qty_decrease"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/textLineQty"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary_dark"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonQtyPlus"
            style="@style/VikrSaathiStepperButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/return_qty_increase"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="+" />

        <TextView
            android:id="@+id/textLinePortion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="@color/text_primary_dark" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkRestock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/return_add_back"
        android:textColor="@color/text_primary_dark"
        app:buttonIconTint="@color/white"
        app:buttonTint="@color/return_checkbox_tint" />

    <TextView
        android:id="@+id/textQuarantine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/return_quarantine_help"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary_dark"
        android:visibility="gone" />
</LinearLayout>
