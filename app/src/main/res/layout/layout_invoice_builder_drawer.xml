<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:elevation="8dp"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/builder_options"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/page_layout_section"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawerTextPageSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/drawerTogglePageOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawerButtonPortrait"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_orientation_portrait" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawerButtonLandscape"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_orientation_landscape" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchLivePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/live_preview" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchSnapGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/snap_to_grid" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchShowGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_grid" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/guides_section"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchSnapGuides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/snap_to_guides" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchSnapObjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/snap_to_objects" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/drawerSwitchShowGuides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_guides" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonAddVerticalGuide"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_vertical_guide" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonAddHorizontalGuide"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_horizontal_guide" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonDeleteGuide"
            style="@style/VikrSaathiOutlinedButton.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/delete_guide" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonExportJson"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_template" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonImportJson"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/import_template" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButtonVersionHistory"
            style="@style/VikrSaathiOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/version_history" />
    </LinearLayout>
</ScrollView>
