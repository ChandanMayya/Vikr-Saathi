<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode variant: subtle dark fill with a faint white border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#14FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/help_glass_corner_radius" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/help_glass_border_bright" />
            <corners android:radius="@dimen/help_glass_corner_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
