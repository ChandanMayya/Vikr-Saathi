<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VikrSaathi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryDark">@color/orange_primary_dark</item>
        <item name="colorPrimaryVariant">@color/orange_primary_dark</item>
        <item name="colorOnPrimary">@color/orange_on_primary</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="colorSecondaryVariant">@color/orange_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorPrimaryContainer">@color/orange_100</item>
        <item name="colorOnPrimaryContainer">@color/orange_900</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/orange_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/stroke_default</item>
        <item name="colorOutlineVariant">@color/stroke_subtle</item>
        <item name="android:colorBackground">@color/orange_surface</item>
        <item name="android:statusBarColor">@color/orange_primary_dark</item>
        <item name="android:navigationBarColor">@color/orange_primary_dark</item>
        <item name="materialSwitchStyle">@style/VikrSaathiSwitch</item>
        <item name="materialButtonOutlinedStyle">@style/VikrSaathiOutlinedButton</item>
    </style>

    <style name="Theme.VikrSaathi.NoActionBar" parent="Theme.VikrSaathi" />

    <style name="Theme.VikrSaathi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orange_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.VikrSaathi</item>
    </style>

    <style name="Theme.VikrSaathi.HelpOverlay" parent="Theme.VikrSaathi">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="VikrSaathiDashboardCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/ripple_subtle</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="VikrSaathiDashboardCardText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/orange_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VikrSaathiDashboardCardIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="VikrSaathiDashboardCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/orange_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VikrSaathiBillLineCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="VikrSaathiBillLineInput">
        <item name="android:background">@drawable/bg_bill_line_input</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Editable numeric fields: center gravity resets cursor when digits are inserted -->
    <style name="VikrSaathiBillLineEditableInput" parent="VikrSaathiBillLineInput">
        <item name="android:gravity">center_vertical|end</item>
    </style>

    <style name="VikrSaathiBillLineLabel">
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="VikrSaathiSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="trackDecorationTint">@color/switch_track_decoration_tint</item>
    </style>

    <style name="VikrSaathiOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/button_outlined_text</item>
        <item name="strokeColor">@color/button_outlined_stroke</item>
    </style>

    <style name="VikrSaathiOutlinedButton.Destructive" parent="VikrSaathiOutlinedButton">
        <item name="android:textColor">@color/button_outlined_text_destructive</item>
        <item name="strokeColor">@color/button_outlined_stroke_destructive</item>
    </style>

    <style name="VikrSaathiPinDot">
        <item name="android:layout_width">@dimen/pin_dot_size</item>
        <item name="android:layout_height">@dimen/pin_dot_size</item>
        <item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:background">@drawable/bg_pin_dot_empty</item>
    </style>

    <style name="VikrSaathiPinKeyRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginBottom">@dimen/pin_key_spacing</item>
    </style>

    <style name="VikrSaathiPinKeyButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">@dimen/pin_key_size</item>
        <item name="android:layout_height">@dimen/pin_key_size</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textColor">@color/pin_key_text</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/pin_key_surface</item>
        <item name="cornerRadius">36dp</item>
        <item name="elevation">3dp</item>
        <item name="rippleColor">@color/pin_key_ripple</item>
    </style>

    <style name="VikrSaathiPinIconKeyButton" parent="VikrSaathiPinKeyButton">
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:minWidth">@dimen/pin_key_size</item>
        <item name="android:minHeight">@dimen/pin_key_size</item>
        <item name="android:text">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">@dimen/pin_icon_size</item>
        <item name="iconTint">@null</item>
    </style>
</resources>
