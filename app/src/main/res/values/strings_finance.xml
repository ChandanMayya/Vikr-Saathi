    <string name="help_accounts_title">Configurations</string>
    <string name="help_accounts_overview">Customer balances, vendors, and orders start on. Switching one off hides that workflow and keeps the data.</string>
    <string name="help_accounts_s1_title">Switches</string>
    <string-array name="help_accounts_s1">
        <item>Enable Customer Balance Management to record cash, UPI, credit, and split payments on bills.</item>
        <item>Enable Vendor Management for vendors, quotes, orders, receipts, invoices, and vendor balances.</item>
        <item>Enable Order Management to show Orders on the dashboard.</item>
        <item>Turning a switch off does not delete ledger entries, vendors, or purchases.</item>
    </string-array>
    <string name="help_customer_ledger_title">Customer balance</string>
    <string name="help_customer_ledger_overview">The balance is the sum of ledger entries. Green means the customer owes the shop. Red means the shop owes the customer.</string>
    <string name="help_customer_ledger_s1_title">Entries</string>
    <string-array name="help_customer_ledger_s1">
        <item>Opening balance is added only when you enter it. It is not guessed from old bills.</item>
        <item>Cash and UPI on a sale are settled. Only the credit portion increases the balance.</item>
        <item>A payment reduces the balance. Anything above the debt stays as an advance.</item>
        <item>A sales return can restock goods, refund money, and reduce credit. Those are separate.</item>
        <item>Corrections need a reason and stay in the ledger as their own entries.</item>
    </string-array>
    <string name="help_vendors_title">Vendors</string>
    <string name="help_vendors_overview">A vendor with purchase or balance history is archived, not deleted.</string>
    <string name="help_vendors_s1_title">Purchasing</string>
    <string-array name="help_vendors_s1">
        <item>A purchase order does not add stock.</item>
        <item>A goods receipt adds stock only for accepted quantity: received, minus damaged, minus rejected.</item>
        <item>A purchase invoice is what you owe. It is separate from the receipt and from the payment.</item>
        <item>Quotes can be for one item or many. Comparison shows rates and a landed total that includes delivery charges.</item>
        <item>A purchase request lists materials for several vendors to quote. Awarding creates one purchase order per vendor.</item>
    </string-array>
    <string name="help_new_bill_payment_note">When customer balances are enabled, choose cash, UPI, credit, or split before saving.</string>
